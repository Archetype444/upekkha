<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#8CA795</item>
        <item name="android:colorControlNormal">#7E8C83</item>
        <item name="android:colorControlActivated">#8CA795</item>
        <item name="android:textColorPrimary">#C4CEC6</item>
        <item name="android:textColorSecondary">#87958B</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/DarkDialog</item>
    </style>
    <style name="DarkDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#8CA795</item>
        <item name="android:textColorPrimary">#C4CEC6</item>
        <item name="android:textColorSecondary">#87958B</item>
    </style>
</resources>
